<Window x:Class="StartupToggle.App.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增启动项"
        Height="392" Width="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <StackPanel Margin="22">
        <TextBlock Text="名称"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" />
        <Border Margin="0,6,0,0" Style="{StaticResource FieldBorder}">
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" />
        </Border>
        <TextBlock Text="任务管理器的启动列表里显示的名字，例如 MyTool。"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextTertiary}" />

        <TextBlock Text="启动命令"
                   Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource FieldBorder}">
                <TextBox x:Name="CommandBox" Style="{StaticResource FieldBox}" />
            </Border>
            <Button Grid.Column="1"
                    Content="浏览…"
                    Margin="8,0,0,0"
                    Style="{StaticResource ToolbarButton}"
                    Click="OnBrowse" />
        </Grid>
        <TextBlock Text="可执行文件路径，含空格会自动加引号；也可以带上参数。"
                   Margin="0,4,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource TextTertiary}" />

        <TextBlock Text="写入位置"
                   Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" />
        <ComboBox x:Name="TargetBox"
                  Margin="0,6,0,0"
                  Height="34"
                  SelectedIndex="0"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="当前用户（HKCU Run，只影响自己）" />
            <ComboBoxItem Content="所有用户（HKLM Run，影响整机）" />
        </ComboBox>

        <TextBlock x:Name="ErrorText"
                   Margin="0,12,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource Danger}" />

        <StackPanel Orientation="Horizontal"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    IsCancel="True"
                    Style="{StaticResource ToolbarButton}" />
            <Button Content="添加"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
