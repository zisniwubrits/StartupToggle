<Window x:Class="StartupToggle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开机启动项管理"
        Height="720" Width="1060"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 提权账户与桌面账户不一致时的黄条 -->
        <Border x:Name="MismatchBanner"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{DynamicResource WarnSoft}"
                BorderBrush="{DynamicResource WarnBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Warn}" />
                <TextBlock x:Name="MismatchText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Warn}" />
            </StackPanel>
        </Border>

        <!-- 标题与工具栏 -->
        <StackPanel Grid.Row="1" Margin="20,18,20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="开机启动项管理"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="SubtitleText"
                           Margin="12,0,0,4"
                           VerticalAlignment="Bottom"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" MaxWidth="380" HorizontalAlignment="Left" Style="{StaticResource FieldBorder}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" TextChanged="OnSearchChanged" />
                        <TextBlock x:Name="SearchHint"
                                   Text="搜索名称或命令"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                </Border>

                <CheckBox x:Name="EnabledOnly"
                          Grid.Column="1"
                          Content="只看已启用"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="OnFilterChanged"
                          Unchecked="OnFilterChanged" />

                <Button Grid.Column="2"
                        Content="刷新"
                        Margin="16,0,0,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnRefresh" />
            </Grid>

            <WrapPanel Margin="0,12,0,0">
                <Button Content="批量启用"
                        Margin="0,0,8,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnBulkEnable" />
                <Button Content="批量禁用"
                        Margin="0,0,8,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnBulkDisable" />
                <Button Content="新增启动项"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnAdd" />
                <Button Content="清理失效项"
                        Margin="0,0,8,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnCleanInvalid" />
                <Button Content="导出 JSON"
                        Margin="0,0,8,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnExport" />
                <Button Content="服务（高级）…"
                        Margin="0,0,8,0"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="打开独立的服务视图：可以开关 Windows 服务（驱动只读）"
                        Click="OnOpenServices" />
                <Button x:Name="RestoreButton"
                        Content="恢复我改过的项"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnRestoreAll" />
            </WrapPanel>
        </StackPanel>

        <!-- 列表 -->
        <Border Grid.Row="2"
                Margin="20,0,20,12"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="ItemsGrid"
                      Margin="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="54"
                      RowStyle="{StaticResource GridRow}"
                      CellStyle="{StaticResource GridCell}"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimary}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanToggle}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="名称" Width="250" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Location}"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="状态" Width="200" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusPill}" ToolTip="{Binding StatusToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Style="{StaticResource StatusDot}" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLabel}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeDanger}"
                                            Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="失效"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Danger}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeNeutral}"
                                            ToolTip="{Binding LockReason}"
                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="受保护"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeNeutral}"
                                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="只读"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="启动命令" Width="*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Command}"
                                           ToolTip="{Binding FullCommand}"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="操作" Width="104" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ActionText}"
                                        Tag="{Binding}"
                                        IsEnabled="{Binding CanToggle}"
                                        Style="{StaticResource PillButton}"
                                        Click="OnToggleRow" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="FooterText"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
