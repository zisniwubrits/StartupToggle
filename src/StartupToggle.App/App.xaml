<Application x:Class="StartupToggle.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StartupToggle.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 用绝对 pack URI：相对路径在被别的程序集加载时会被解析到入口程序集上 -->
                <ResourceDictionary Source="pack://application:,,,/StartupToggle;component/Themes/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/StartupToggle;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
