<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FBFBFB" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F5F5F5" />

    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#616161" />
    <SolidColorBrush x:Key="TextTertiary" Color="#9A9A9A" />

    <SolidColorBrush x:Key="BorderSoft" Color="#E3E3E3" />
    <SolidColorBrush x:Key="BorderStrong" Color="#D0D0D0" />

    <SolidColorBrush x:Key="Accent" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E5F1FB" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#DFF6DD" />
    <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA" />
    <SolidColorBrush x:Key="Warn" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarnBorder" Color="#F0D68A" />

    <SolidColorBrush x:Key="ControlBackground" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ControlHover" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlPressed" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ControlDisabled" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#E5F1FB" />

</ResourceDictionary>
