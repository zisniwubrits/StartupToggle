<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#2F2F2F" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#383838" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8A8A8A" />

    <SolidColorBrush x:Key="BorderSoft" Color="#3D3D3D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4A4A4A" />

    <SolidColorBrush x:Key="Accent" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1B3A4B" />
    <SolidColorBrush x:Key="AccentText" Color="#08222E" />

    <SolidColorBrush x:Key="Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#20361D" />
    <SolidColorBrush x:Key="Danger" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerSoft" Color="#422521" />
    <SolidColorBrush x:Key="Warn" Color="#FCE100" />
    <SolidColorBrush x:Key="WarnSoft" Color="#3D331A" />
    <SolidColorBrush x:Key="WarnBorder" Color="#5C4B1F" />

    <SolidColorBrush x:Key="ControlBackground" Color="#323232" />
    <SolidColorBrush x:Key="ControlHover" Color="#3B3B3B" />
    <SolidColorBrush x:Key="ControlPressed" Color="#454545" />
    <SolidColorBrush x:Key="ControlDisabled" Color="#2A2A2A" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#1B3A4B" />

</ResourceDictionary>
