<Window x:Class="StartupToggle.App.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务（高级）— 开机启动项管理"
        Height="700" Width="1060"
        MinHeight="480" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="TypeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuto}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAuto}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 提示条 -->
        <Border Grid.Row="0"
                Background="{DynamicResource WarnSoft}"
                BorderBrush="{DynamicResource WarnBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Warn}" />
                <TextBlock FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Warn}"
                           Text="驱动类服务一律只读；关键系统服务（RPC、登录、网络、安全中心等）已锁定。改服务会影响系统行为，禁用前会提示有哪些服务依赖它。" />
            </StackPanel>
        </Border>

        <!-- 标题与工具栏 -->
        <StackPanel Grid.Row="1" Margin="20,16,20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Windows 服务"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="SubtitleText"
                           Margin="12,0,0,4"
                           VerticalAlignment="Bottom"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left" Style="{StaticResource FieldBorder}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" TextChanged="OnSearchChanged" />
                        <TextBlock x:Name="SearchHint"
                                   Text="搜索显示名、服务名或描述"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                </Border>

                <CheckBox x:Name="AutoOnly"
                          Grid.Column="1"
                          Content="只看自动启动"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="OnFilterChanged"
                          Unchecked="OnFilterChanged" />

                <CheckBox x:Name="ShowDrivers"
                          Grid.Column="2"
                          Content="显示驱动"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="OnFilterChanged"
                          Unchecked="OnFilterChanged" />

                <Button Grid.Column="3"
                        Content="刷新"
                        Margin="16,0,0,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnRefresh" />

                <Button x:Name="RestoreButton"
                        Grid.Column="4"
                        Content="恢复我改过的项"
                        Margin="8,0,0,0"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnRestoreAll" />
            </Grid>
        </StackPanel>

        <!-- 列表 -->
        <Border Grid.Row="2"
                Margin="20,0,20,12"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="ServicesGrid"
                      Margin="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="50"
                      RowStyle="{StaticResource GridRow}"
                      CellStyle="{StaticResource GridCell}"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimary}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="服务" Width="300" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DescriptionText}"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <Border Style="{StaticResource BadgeNeutral}"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{Binding LockReason}">
                                            <TextBlock Text="受保护"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeNeutral}"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding IsDriver, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="驱动"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               FontFamily="Cascadia Mono, Consolas"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="启动类型" Width="150" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource TypeDot}" />
                                    <TextBlock Text="{Binding StartTypeText}" Style="{StaticResource TypeText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="运行状态" Width="110" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RunStateText}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="被依赖" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DependentsText}"
                                           ToolTip="{Binding DependentsToolTip}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="操作" Width="*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ActionText}"
                                        Tag="{Binding}"
                                        IsEnabled="{Binding CanToggle}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PillButton}"
                                        Click="OnToggleRow" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="FooterText"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
